PORT=3001
BEVVI_API_BASE_URL=https://api.getbevvi.com
CORS_ORIGIN=http://localhost:3002

# Production: customer is resolved from the hostname
#   https://<customer>.ordertracker.getbevvi.com
# Local dev: set VITE_CUSTOMER to simulate a white-label site (optional).
# Leave empty to show the in-app customer switcher on localhost.
VITE_CUSTOMER=

# Override the hostname suffix (default: ordertracker.getbevvi.com)
# VITE_CUSTOMER_HOST_SUFFIX=ordertracker.getbevvi.com
